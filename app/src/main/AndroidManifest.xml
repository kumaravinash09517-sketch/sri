<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.blurr.voice.v2"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Minimal required permissions left in place -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:label="Sarkar AI Receptionist"
        android:icon="@android:drawable/sym_def_app_icon">

        <!-- Accessibility service declaration: keep meta-data reference to a valid xml config -->
        <service
            android:name=".AgentService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Launcher activity (safe, minimal UI) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keep PermissionActivity available for permissions UI if needed later -->
        <activity
            android:name=".PermissionActivity"
            android:exported="true" />

    </application>
</manifest>
